{
  "name": "portfolio",
  "version": "3.0.0",
  "author": "Marcos Lopez",
  "description": "Marcos Lopez Portfolio website",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "serve:ssr:lastv": "node dist/lastv/server/server.mjs",
    "serve:ssr:testing": "node dist/portfolio/server/server.mjs",
    "storybook": "ng run portfolio:storybook",
    "build:storybook": "ng run portfolio:build-storybook"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "21.2.3",
    "@angular/cdk": "^21.2.2",
    "@angular/common": "21.2.3",
    "@angular/compiler": "21.2.3",
    "@angular/core": "21.2.3",
    "@angular/forms": "21.2.3",
    "@angular/platform-browser": "21.2.3",
    "@angular/platform-browser-dynamic": "21.2.3",
    "@angular/platform-server": "21.2.3",
    "@angular/router": "21.2.3",
    "@angular/ssr": "21.2.2",
    "aos": "2.3.4",
    "atropos": "2.0.2",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "ng-particles": "3.12.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "tsparticles-engine": "2.12.0",
    "tsparticles-slim": "2.12.0",
    "vanilla-tilt": "1.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.2",
    "@angular/build": "21.2.2",
    "@angular/cli": "21.2.2",
    "@angular/compiler-cli": "21.2.3",
    "@chromatic-com/storybook": "^5.0.1",
    "@compodoc/compodoc": "^1.2.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-docs": "10.2.17",
    "@storybook/angular": "10.2.17",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/aos": "3.0.7",
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "eslint": "^10.0.3",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "msw-storybook-addon": "^2.0.6",
    "postcss": "^8.5.8",
    "storybook": "10.2.17",
    "tailwindcss": "^4.2.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.7.0"
  },
  "keywords": [],
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
